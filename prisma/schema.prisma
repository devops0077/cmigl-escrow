// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                    String               @id @default(cuid())
  name                  String?
  email                 String?              @unique
  username              String?              @unique
  phone                 String               @unique
  emailVerified         DateTime?
  isActive              Boolean              @default(false)
  registrationFee       RegistrationFee?
  image                 String?
  bio                   String?
  address               String?
  passportImage         String? // Added passport image field
  password              String?
  role                  UserRole             @default(USER)
  status                UserStatus           @default(PENDING)
  restricted            Boolean              @default(false)
  termsAccepted         Boolean              @default(false)
  accounts              Account[]
  sessions              Session[]
  sentTransactions      Transaction[]        @relation("SentTransactions")
  receivedTransactions  Transaction[]        @relation("ReceivedTransactions")
  wallet                Wallet?
  notifications         Notification[]
  verificationToken     VerificationToken?
  paystackCustomerId    String? // Paystack customer ID
  paystackRecipientCode String? // For transfers/withdrawals
  bankAccounts          BankAccount[]
  subscriptions         Subscription[]
  feedbacks             PlatformFeedback[]
  contentItems          ContentItem[]
  disputesInitiated     Dispute[]            @relation("DisputeInitiator")
  Feedback              Feedback[]           @relation("GaveFeedback")
  feedbackReceived      Feedback[]           @relation("ReceivedFeedback")
  restrictions          UserRestriction[]    @relation("UserRestriction")
  restrictionResovedBy  UserRestriction[]    @relation("RestrictionResovedBy")
  restrictionAppliedBy  UserRestriction[]    @relation("RestrictionAppliedBy")
  rewardDistributions   RewardDistribution[] @relation("UserRewards")
  createdRewardPrograms RewardProgram[]      @relation("RewardProgramCreator")
  rewardAuditLogs       RewardAuditLog[]     @relation("RewardAuditor")
  createdAds            Advertisement[]      @relation("AdCreator")
  adImpressions         AdImpression[]       @relation("AdImpressions")
  adClicks              AdClick[]            @relation("AdClicks")
  revenue               Revenue[]
  userSettings          UserSettings?
  securityLogs          SecurityLog[]        @relation("UserSecurityLogs")
  pushSubscriptions     PushSubscription[]   @relation("UserPushSubscriptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  theme              String   @default("system")
  language           String   @default("en")
  timezone           String   @default("UTC")
  currency           String   @default("NGN")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  marketingEmails    Boolean  @default(false)
  securityAlerts     Boolean  @default(true)
  transactionUpdates Boolean  @default(true)
  promotionalOffers  Boolean  @default(false)
  reducedMotion      Boolean  @default(false)
  notificationSound  String   @default("default")
  pushNotifications  Boolean  @default(true) // Added for push notification preferences
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  balance       Float               @default(0)
  escrowBalance Float               @default(0)
  currency      String              @default("NGN")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]
}

model WalletTransaction {
  id                 String              @id @default(cuid())
  walletId           String
  amount             Float
  type               TransactionType
  status             TransactionStatus   @default(PENDING)
  reference          String?             @unique // Paystack reference
  description        String?
  metadata           Json? // Additional data
  paymentMethod      PaymentMethod? // Method used
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  wallet             Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  paymentId          String?             @unique // Link to Payment model
  payment            Payment?            @relation(fields: [paymentId], references: [id])
  rewardDistribution RewardDistribution?
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
  REFUND
  FEE
}

model Transaction {
  id              String            @id @default(cuid())
  buyerId         String
  sellerId        String
  amount          Float
  escrowFee       Float
  productDetails  String?
  productCategory String?
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  buyer           User              @relation("SentTransactions", fields: [buyerId], references: [id])
  seller          User              @relation("ReceivedTransactions", fields: [sellerId], references: [id])
  feedbacks       Feedback?
  paymentId       String?           @unique // Link to Payment model
  payment         Payment?          @relation(fields: [paymentId], references: [id])
  dispute         Dispute? // Added relation to dispute
  hasDispute      Boolean           @default(false) // Flag to indicate if transaction has a dispute
  revenue         Revenue[]
}

model Feedback {
  id            String      @id @default(cuid())
  transactionId String      @unique
  giverId       String
  receiverId    String
  rating        Int
  comment       String?
  isPublic      Boolean
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  receiver      User        @relation("ReceivedFeedback", fields: [receiverId], references: [id])
  giver         User        @relation("GaveFeedback", fields: [giverId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  SHIPPED
  CONFIRMED
  DISPUTED // Added disputed status
  RESOLVED // Added resolved status
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ESCROW_PAYMENT
  ESCROW_REFUND
  ESCROW_RELEASE
  REGISTRATION_FEE
  DISPUTE_RESOLUTION // Added dispute resolution type
  REWARD // Added reward type
}

model Notification {
  id                 String            @id @default(cuid())
  userId             String
  title              String
  message            String
  type               NotificationType  @default(SYSTEM_NOTIFICATION)
  read               Boolean           @default(false)
  data               Json?
  createdAt          DateTime          @default(now())
  pushNotificationId String?           @unique
  pushNotification   PushNotification? @relation(fields: [pushNotificationId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  TRANSACTION_CREATED
  TRANSACTION_STATUS_CHANGED
  WALLET_UPDATED
  SYSTEM_NOTIFICATION
  ADMIN_NOTIFICATION
  REGISTRATION
  DISPUTE_CREATED // Added dispute notification types
  DISPUTE_UPDATED
  DISPUTE_RESOLVED
}

// New model for push subscriptions
model PushSubscription {
  id             String    @id @default(cuid())
  userId         String
  endpoint       String    @unique
  p256dh         String // Public key
  auth           String // Auth secret
  userAgent      String? // Browser/device info
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastUsed       DateTime?
  expirationTime DateTime?
  isActive       Boolean   @default(true)

  // Relations
  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// New model for tracking push notifications
model PushNotification {
  id           String                 @id @default(cuid())
  title        String
  body         String
  icon         String?
  badge        String?
  image        String?
  tag          String?
  data         Json?
  url          String?
  sound        String?
  status       PushNotificationStatus @default(PENDING)
  sentAt       DateTime?
  deliveredAt  DateTime?
  clickedAt    DateTime?
  errorMessage String?
  createdAt    DateTime               @default(now())
  notification Notification?

  @@index([status])
  @@index([createdAt])
}

enum PushNotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  CLICKED
}

model Payment {
  id                String             @id @default(cuid())
  amount            Float
  currency          String             @default("NGN")
  reference         String             @unique // Paystack reference
  status            PaymentStatus      @default(PENDING)
  paymentMethod     PaymentMethod
  paymentGateway    PaymentGateway     @default(PAYSTACK)
  metadata          Json? // Additional data
  gatewayResponse   String? // Response from payment gateway
  authorizationCode String? // For recurring payments
  cardType          String? // Visa, Mastercard, etc.
  last4             String? // Last 4 digits of card
  expMonth          String? // Card expiry month
  expYear           String? // Card expiry year
  channel           String? // card, bank, ussd, qr, etc.
  ipAddress         String? // Customer IP address
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transaction       Transaction?
  walletTransaction WalletTransaction?
  webhookEvents     WebhookEvent[]
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  QR_CODE
  BANK
  WALLET
  MOBILE_MONEY
}

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
  MANUAL
}

model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  bankName      String
  accountNumber String
  accountName   String
  bankCode      String // Bank code for Paystack
  recipientCode String? // Paystack recipient code
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planCode         String // Paystack plan code
  subscriptionCode String             @unique // Paystack subscription code
  status           SubscriptionStatus @default(ACTIVE)
  amount           Float
  nextPaymentDate  DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventType String // charge.success, transfer.success, etc.
  eventData Json // Full webhook payload
  processed Boolean  @default(false)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  createdAt DateTime @default(now())
}

model RegistrationFee {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Float    @default(500)
  paid      Boolean  @default(false)
  reference String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// New model for disputes
model Dispute {
  id            String           @id @default(cuid())
  transactionId String           @unique
  initiatorId   String
  reason        String
  description   String?
  evidence      String? // URL to uploaded evidence file
  status        DisputeStatus    @default(OPEN)
  adminNotes    String?
  sellerAmount  Float? // Amount to be released to seller (admin decision)
  buyerAmount   Float? // Amount to be refunded to buyer (admin decision)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  resolvedAt    DateTime?
  transaction   Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  initiator     User             @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  messages      DisputeMessage[]
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CANCELLED
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  userId    String
  message   String
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

model PlatformFeedback {
  id          String         @id @default(cuid())
  userId      String
  title       String
  description String         @db.Text
  rating      Int
  type        FeedbackType
  status      FeedbackStatus @default(PENDING)
  attachments String? // URL to attachment file
  adminNotes  String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRestriction {
  id              String    @id @default(cuid())
  userId          String
  reason          String
  details         String
  appliedById     String
  active          Boolean
  appealSubmitted Boolean   @default(false)
  appliedAt       DateTime?
  appealText      String?
  appealDate      DateTime?
  resolvedAt      DateTime?
  resolvedById    String?
  user            User      @relation("UserRestriction", fields: [userId], references: [id])
  resolvedBy      User?     @relation("RestrictionResovedBy", fields: [resolvedById], references: [id])
  appliedBy       User?     @relation("RestrictionAppliedBy", fields: [appliedById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum FeedbackType {
  SUGGESTION
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  IMPLEMENTED
  REJECTED
}

// New model for content management
model ContentItem {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  content     String            @db.Text
  type        ContentType
  category    String?
  tags        String[]
  published   Boolean           @default(false)
  authorId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?
  version     Int               @default(1)
  author      User              @relation(fields: [authorId], references: [id])
  revisions   ContentRevision[]
}

model ContentRevision {
  id          String      @id @default(cuid())
  contentId   String
  content     String      @db.Text
  version     Int
  createdAt   DateTime    @default(now())
  contentItem ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
}

enum ContentType {
  KNOWLEDGE_BASE
  TUTORIAL
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  FAQ
}

model RewardProgram {
  id            String               @id @default(cuid())
  name          String
  description   String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  createdById   String
  createdBy     User                 @relation("RewardProgramCreator", fields: [createdById], references: [id])
  criteria      RewardCriteria[]
  schedules     RewardSchedule[]
  distributions RewardDistribution[]
  auditLogs     RewardAuditLog[]
  linkedAds     Advertisement[]      @relation("AdRewardProgram")
}

model RewardCriteria {
  id              String        @id @default(cuid())
  programId       String
  program         RewardProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  criteriaType    CriteriaType
  minTransactions Int? // Minimum number of transactions
  minVolume       Float? // Minimum transaction volume
  minAccountAge   Int? // Minimum account age in days
  userRole        UserRole? // Target specific user roles
  customQuery     String? // For complex criteria (JSON)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RewardSchedule {
  id            String        @id @default(cuid())
  programId     String
  program       RewardProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  scheduleType  ScheduleType
  amount        Float // Reward amount
  currency      String        @default("NGN")
  startDate     DateTime
  endDate       DateTime?
  frequency     Frequency? // For recurring rewards
  dayOfWeek     Int? // 0-6 for weekly (0 = Sunday)
  dayOfMonth    Int? // 1-31 for monthly
  lastRun       DateTime? // Last time this schedule was executed
  nextRun       DateTime? // Next scheduled run
  maxRewards    Int? // Maximum number of rewards to distribute
  rewardsIssued Int           @default(0) // Number of rewards already issued
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model RewardDistribution {
  id                String             @id @default(cuid())
  programId         String
  program           RewardProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId            String
  user              User               @relation("UserRewards", fields: [userId], references: [id])
  amount            Float
  currency          String             @default("NGN")
  status            RewardStatus       @default(PENDING)
  transactionId     String?            @unique // Reference to wallet transaction if applicable
  walletTransaction WalletTransaction? @relation(fields: [transactionId], references: [id])
  metadata          Json? // Additional data about the reward
  distributedAt     DateTime           @default(now())
  processedAt       DateTime? // When the reward was processed
  failureReason     String? // If the reward failed
}

model RewardAuditLog {
  id            String        @id @default(cuid())
  programId     String
  program       RewardProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  actionType    RewardAction
  performedById String
  performedBy   User          @relation("RewardAuditor", fields: [performedById], references: [id])
  details       Json // Details of the action
  timestamp     DateTime      @default(now())
  ipAddress     String? // IP address of the admin
  userAgent     String? // User agent of the admin
}

enum CriteriaType {
  TRANSACTION_COUNT
  TRANSACTION_VOLUME
  ACCOUNT_AGE
  USER_ROLE
  CUSTOM
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum RewardStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RewardAction {
  PROGRAM_CREATED
  PROGRAM_UPDATED
  PROGRAM_DELETED
  PROGRAM_ACTIVATED
  PROGRAM_DEACTIVATED
  CRITERIA_ADDED
  CRITERIA_UPDATED
  CRITERIA_REMOVED
  SCHEDULE_ADDED
  SCHEDULE_UPDATED
  SCHEDULE_REMOVED
  REWARDS_DISTRIBUTED
  MANUAL_REWARD_ISSUED
}

enum AdvertisementType {
  BANNER
  POPUP
  FLASH
  TEXT
  REWARD_PROMO
}

enum AdStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SCHEDULED
}

enum TargetingType {
  USER_ROLE
  TRANSACTION_HISTORY
  ACCOUNT_AGE
  REWARD_ELIGIBILITY
  LOCATION
  CUSTOM
}

enum AdPlacement {
  HOMEPAGE
  DASHBOARD
  SIDEBAR
  TRANSACTION_PAGE
  WALLET_PAGE
  PROFILE_PAGE
  GLOBAL
}

enum AdFrequency {
  EVERY_TIME
  ONCE_PER_SESSION
  ONCE_PER_DAY
  ONCE_PER_WEEK
  CUSTOM
}

model Advertisement {
  id             String            @id @default(cuid())
  name           String
  description    String?
  type           AdvertisementType
  content        Json // Flexible content structure based on ad type
  status         AdStatus          @default(DRAFT)
  priority       Int               @default(1) // Higher priority ads shown first
  maxImpressions Int? // Maximum number of times to display (null = unlimited)
  maxClicks      Int? // Maximum number of clicks (null = unlimited) 
  startDate      DateTime
  endDate        DateTime?
  createdById    String
  createdBy      User              @relation("AdCreator", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  targetingRules TargetingRule[]
  displayRules   DisplayRule[]
  impressions    AdImpression[]
  clicks         AdClick[]
  linkedRewardId String? // Optional link to a reward program
  linkedReward   RewardProgram?    @relation("AdRewardProgram", fields: [linkedRewardId], references: [id])
}

model TargetingRule {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  ruleType        TargetingType
  conditions      Json // Flexible conditions structure based on rule type
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DisplayRule {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  placement       AdPlacement
  frequency       AdFrequency   @default(EVERY_TIME)
  displayLimit    Int? // Limit per user per time period (null = unlimited)
  timeFrame       Int? // Time frame in hours for display limit (null = all time)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AdImpression {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  userId          String? // Optional - can track anonymous impressions too
  user            User?         @relation("AdImpressions", fields: [userId], references: [id])
  timestamp       DateTime      @default(now())
  placement       AdPlacement
  sessionId       String? // Browser session ID
  deviceInfo      String? // Device information
}

model AdClick {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  userId          String? // Optional - can track anonymous clicks too
  user            User?         @relation("AdClicks", fields: [userId], references: [id])
  timestamp       DateTime      @default(now())
  placement       AdPlacement
  sessionId       String? // Browser session ID
  deviceInfo      String? // Device information
}

enum RevenueType {
  ESCROW_FEE
  REGISTRATION_FEE
  OTHER
}

enum RevenueStatus {
  COLLECTED
  PENDING
  REFUNDED
}

model Revenue {
  id            String        @id @default(cuid())
  amount        Float
  type          RevenueType
  status        RevenueStatus @default(COLLECTED)
  description   String?
  metadata      Json?
  transactionId String?
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([transactionId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SecurityLog {
  id         String            @id @default(cuid())
  userId     String
  eventType  SecurityEventType
  ipAddress  String?
  userAgent  String?
  deviceInfo String?
  location   String?
  metadata   Json? // Additional data about the event
  successful Boolean           @default(true)
  sessionId  String? // Reference to the session if applicable
  createdAt  DateTime          @default(now())

  // Relations
  user User @relation("UserSecurityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_logs")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  PROFILE_UPDATED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  TWO_FACTOR_CHALLENGE_SUCCESS
  TWO_FACTOR_CHALLENGE_FAILED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SUSPICIOUS_ACTIVITY
  NEW_DEVICE_DETECTED
  NEW_LOCATION_DETECTED
  SETTINGS_CHANGED
  API_KEY_CREATED
  API_KEY_DELETED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETED
}
